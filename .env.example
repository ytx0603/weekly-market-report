# 每周趋势雷达 — 环境变量配置
# 复制此文件为 .env，填入真实值即可本地测试
# ⚠️ .env 文件绝不能上传到 GitHub！已在 .gitignore 中排除

# DeepSeek API（去 platform.deepseek.com 拿）
DEEPSEEK_API_KEY=sk-your-key-here

# QQ 邮箱 SMTP（去 QQ邮箱 → 设置 → 账户 → POP3/SMTP 服务 → 开启 → 拿授权码）
QQ_EMAIL=your_qq@qq.com
QQ_SMTP_CODE=your_smtp_authorization_code

# 收件邮箱（不填默认发给自己）
RECIPIENT_EMAIL=your_qq@qq.com

# GitHub Token（可选，提升 API 限速。本地可不填，Actions 自动提供）
GITHUB_TOKEN=
